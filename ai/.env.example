# OpenAI
OPENAI_API_KEY=your_openai_key_here
ANALYSIS_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
EMBEDDING_MODEL=text-embedding-3-small

# Backend API (for seeding)
BACKEND_BASE_URL=http://backend:8080
BACKEND_MINDSETS_PATH=/api/mindsets
BACKEND_CRITERIA_PATH=/api/criteria
BACKEND_ACTIVITY_CRITERIA_PATH=/api/activity-criteria
BACKEND_TIMEOUT_SECONDS=15
BACKEND_AUTH_HEADER=Authorization
BACKEND_AUTH_TOKEN=Bearer your_backend_token

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_COLLECTION_MINDSETS=mindset_definitions
CHROMA_COLLECTION_CRITERIA=activity_criteria
CHROMA_COLLECTION_PATTERNS=behavioral_patterns
CHROMA_COLLECTION_RULES=interpretation_rules
CHROMA_SEED_BATCH_SIZE=64
SEED_DATA_PATH=seed_data
RAG_TOP_K=4

# App
APP_ENV=development
MAX_PROMPT_TOKENS=1200
